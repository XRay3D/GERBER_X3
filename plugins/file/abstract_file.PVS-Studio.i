    operator T() const { return S::fromSpecial(val); }

    bool operator ==(QSpecialInteger<S> i) const { return val == i.val; }
    bool operator !=(QSpecialInteger<S> i) const { return val != i.val; }

    QSpecialInteger &operator +=(T i)
    { return (*this = S::fromSpecial(val) + i); }
    QSpecialInteger &operator -=(T i)
    { return (*this = S::fromSpecial(val) - i); }
    QSpecialInteger &operator *=(T i)
    { return (*this = S::fromSpecial(val) * i); }
    QSpecialInteger &operator >>=(T i)
    { return (*this = S::fromSpecial(val) >> i); }
    QSpecialInteger &operator <<=(T i)
    { return (*this = S::fromSpecial(val) << i); }
    QSpecialInteger &operator /=(T i)
    { return (*this = S::fromSpecial(val) / i); }
    QSpecialInteger &operator %=(T i)
    { return (*this = S::fromSpecial(val) % i); }
    QSpecialInteger &operator |=(T i)
    { return (*this = S::fromSpecial(val) | i); }
    QSpecialInteger &operator &=(T i)
    { return (*this = S::fromSpecial(val) & i); }
    QSpecialInteger &operator ^=(T i)
    { return (*this = S::fromSpecial(val) ^ i); }
